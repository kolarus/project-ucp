{
  "name": "project-ucp",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "validate": "pnpm format:check && pnpm check-docs && pnpm check-architecture && pnpm typecheck && pnpm test && pnpm lint && pnpm knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-docs": "node scripts/check-docs.mts",
    "check-architecture": "node scripts/check-architecture.mts",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:visual": "node scripts/test-visual.mts",
    "test:visual:update": "node scripts/test-visual.mts --update",
    "lint": "pnpm -r lint",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@project-ucp/tsconfig": "workspace:*",
    "@types/node": "^24",
    "knip": "^6",
    "lefthook": "^2",
    "prettier": "^3",
    "typescript": "^5"
  }
}
